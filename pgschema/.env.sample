# pgschema — sample environment file
#
# Copy this to `.env` in the pgschema/ directory and fill in real values:
#
#   cp .env.sample .env
#
# mise loads pgschema/.env automatically for every `mise run <task>` and for
# `mise exec` / any shell with `mise activate` (see the `[env]` block in
# mise.toml). `.env` itself is gitignored — never commit real credentials.
#
# This file also doubles as the "getting started" showcase for the two
# binaries pgschema wraps: pgroll (schema migration) and pgstream (CDC /
# anonymization). Install both with `mise run install-tools` first.
#
# For the full interactive pgroll-workflow demo (5 real-life migration
# scenarios, driven live through Temporal from a web UI), see demo/README.md
# — the defaults below already point at that demo database, so
#   mise run demo-reset && mise run dev
# is enough to get it running with no further edits to this file.

# ─── Temporal ────────────────────────────────────────────────────────────────
# Address of the Temporal frontend. Matches `temporal server start-dev`'s
# default, so this is only needed if you're pointing at a non-default
# server (e.g. Temporal Cloud).
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default

# Webhook the worker POSTs AlertMessage to when a workflow needs human
# escalation (e.g. a Slack incoming-webhook URL). Leave blank to disable
# paging in dev — the worker logs a warning and continues.
PGSCHEMA_ALERT_WEBHOOK_URL=

# ─── pgroll getting-started (schema migration) ────────────────────────────────
# DSN of the database pgroll manages. Point this at a local scratch Postgres,
# e.g. `postgres://postgres:postgres@localhost:5432/pgschema_demo?sslmode=disable`.
PGROLL_DSN=postgres://postgres:postgres@localhost:5432/pgschema_demo?sslmode=disable
SCHEMA=public
# Path to a pgroll migration JSON file, consumed by `mise run migrate-start`.
# See https://pgroll.com for the migration file format, or demo/migrations/
# for 6 real (tested) examples ranging from basic to complex.
MIGRATION_FILE=./demo/migrations/01_add_email.json

# ─── pgstream getting-started (CDC / anonymization) ────────────────────────────
# Source and target DSNs for `mise run stream-start`. For a first run these
# can point at the same database pgroll is managing above and a second local
# database to replicate into.
SOURCE_DSN=postgres://postgres:postgres@localhost:5432/pgschema_demo?sslmode=disable
TARGET_DSN=postgres://postgres:postgres@localhost:5432/pgschema_demo_replica?sslmode=disable
